{
  "schemaVersion": "2.2",
  "description": "Deploy a verified FinBot ARM64 image using the root-owned helper; no arbitrary shell commands.",
  "parameters": {
    "ImageDigest": {"type": "String", "allowedPattern": "^sha256:[0-9a-f]{64}$"},
    "CommitSha": {"type": "String", "allowedPattern": "^[0-9a-f]{40}$"},
    "ScriptSha256": {"type": "String", "allowedPattern": "^[0-9a-f]{64}$"}
  },
  "mainSteps": [{
    "action": "aws:runShellScript",
    "name": "DeployBackend",
    "inputs": {
      "timeoutSeconds": "900",
      "runCommand": [
        "set -eu",
        "helper=/usr/local/libexec/finbot-tradingagents/versions/{{ ScriptSha256 }}.py",
        "if [ ! -f \"$helper\" ]; then helper=/usr/local/libexec/finbot-tradingagents/deploy.py; fi",
        "test \"$(sha256sum \"$helper\" | cut -d ' ' -f 1)\" = '{{ ScriptSha256 }}'",
        "exec python3 \"$helper\" --digest '{{ ImageDigest }}' --commit '{{ CommitSha }}'"
      ]
    }
  }]
}
