FROM python:3.13-slim AS builder
ENV PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
WORKDIR /build
COPY . .
RUN pip install --no-cache-dir -c constraints/worker.txt '.[backend]'

FROM builder AS test-runner
RUN pip install --no-cache-dir -c constraints/worker.txt '.[dev,backend]'

FROM test-runner AS test
RUN TRADINGAGENTS_NO_UPDATE_CHECK=1 python -m pytest -p no:cacheprovider -q --tb=short

FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TRADINGAGENTS_NO_UPDATE_CHECK=1
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN useradd --create-home appuser && install -d -m 0700 -o appuser -g appuser /data
USER appuser
WORKDIR /home/appuser/app
COPY --from=builder --chown=appuser:appuser /build/examples ./examples
COPY --from=builder /build/deploy/migrations /opt/finbot-migrations
COPY --from=builder /build/deploy/personal/migrate.py /opt/finbot-migrations/runner.py
RUN python /opt/finbot-migrations/runner.py --validate
ENTRYPOINT ["python", "-m", "tradingagents.service.cli"]
